{
    "name": "ns-suitecontainer",
    "private": true,
    "type": "module",
    "workspaces": [
        "server",
        "client"
    ],
    "scripts": {
        "build": "node copy-runtime.mjs && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "dev": "npm --workspace server run dev --",
        "start": "node dist/install.js --serve",
        "sftp": "node --experimental-strip-types src/sftp.ts",
        "format": "prettier --config ../setup/.prettierrc --write .",
        "test": "npm run test:frontend && npm --workspace server run test",
        "test:frontend": "npm --workspace client run test"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.3",
        "hono": "^4.13.12"
    },
    "devDependencies": {
        "@types/node": "^24.19.1",
        "prettier": "3.9.9",
        "tsx": "^4.23.0",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
