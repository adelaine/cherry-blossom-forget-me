{
    "name": "ns-suitecontainer",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node copy-runtime.mjs && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "dev": "tsx watch src/install.ts --serve",
        "dev:web": "tsx watch dev/web-preview.ts",
        "start": "node dist/install.js --serve",
        "format": "prettier --config ../setup/.prettierrc --write .",
        "test": "node --experimental-strip-types --test test/install.spec.ts test/web.spec.ts test/web-routing.spec.ts test/web-preview.spec.ts test/build.spec.ts test/sql-password-crypto.spec.ts test/sql-unlock.spec.ts"
    },
    "dependencies": {
        "@alpinejs/csp": "^3.17.4",
        "@hono/node-server": "^2.1.3",
        "@picocss/pico": "^2.1.1",
        "alpinejs": "^3.17.4",
        "hono": "^4.13.12"
    },
    "devDependencies": {
        "@types/alpinejs": "^3.17.0",
        "@types/node": "^24.19.1",
        "prettier": "3.9.9",
        "tsx": "^4.23.0",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
