{
    "name": "ns-suitecontainer",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node ../setup/node/copy-runtime.mjs . && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "dev": "vite --config server/vite.config.ts",
        "start": "node dist/install.js --serve",
        "sftp": "node --experimental-strip-types server/src/sftp.ts",
        "format": "node ../setup/node/format.mjs --write",
        "test": "npm run test:frontend && npm run test:backend",
        "test:frontend": "node --experimental-strip-types --test client/test/ansi.spec.ts client/test/web-page.spec.ts",
        "test:backend": "node --experimental-strip-types --test server/test/api/credentials.spec.ts server/test/api/deployment.spec.ts server/test/api/sql.spec.ts server/test/copy-runtime.spec.ts server/test/main.spec.ts server/test/sql-password-crypto.spec.ts server/test/step-config.spec.ts server/test/step-deploy.spec.ts server/test/step-launch.spec.ts",
        "format:check": "node ../setup/node/format.mjs --check"
    },
    "dependencies": {
        "@alpinejs/csp": "^3.17.4",
        "@hono/node-server": "^2.1.3",
        "@picocss/pico": "^2.1.1",
        "alpinejs": "^3.17.4",
        "hono": "^4.13.12"
    },
    "devDependencies": {
        "@hono/vite-dev-server": "0.26.1",
        "@types/alpinejs": "^3.17.0",
        "@types/node": "^24.19.1",
        "prettier": "3.9.10",
        "tsx": "^4.23.0",
        "typescript": "^7.0.2",
        "vite": "^6.4.1"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
