FROM container-registry.eng.netsuite.com/oracle/oraclelinux10-nodejs:24 AS build

WORKDIR /app
COPY app/package.json app/package-lock.json app/tsconfig.json ./
COPY app/src ./src
RUN --mount=type=secret,id=npmrc --mount=type=secret,id=npm-token \
    if [ -f /run/secrets/npm-token ]; then export NSX_NPM_TOKEN="$(cat /run/secrets/npm-token)"; fi \
    && npm ci --userconfig=/run/secrets/npmrc --ignore-scripts --no-audit --no-fund && npm run build

FROM container-registry.eng.netsuite.com/oracle/oraclelinux10-nodejs:24

USER root
RUN if command -v dnf >/dev/null 2>&1; then \
      dnf install -y git openssl ca-certificates java-21-openjdk-devel && dnf clean all; \
    else \
      microdnf install -y git openssl ca-certificates java-21-openjdk-devel && microdnf clean all; \
    fi

# Accept the Oracle Free Use Terms and Conditions for unattended builds.
ARG SUITECLOUD_CLI_ACCEPT_LICENSE=true
# Supplied by the CodeBox launcher for the SDK download.
ARG SUITECLOUD_PROXY
RUN --mount=type=secret,id=npmrc --mount=type=secret,id=npm-token \
    if [ -f /run/secrets/npm-token ]; then export NSX_NPM_TOKEN="$(cat /run/secrets/npm-token)"; fi \
    && test "$SUITECLOUD_CLI_ACCEPT_LICENSE" = true \
    && SUITECLOUD_CLI_ACCEPT_LICENSE=true npm install -g --userconfig=/run/secrets/npmrc --allow-scripts=@oracle/suitecloud-cli @oracle/suitecloud-cli \
    && test -n "$(find "$HOME/.suitecloud-sdk/cli" -maxdepth 1 -name '*.jar' -print -quit)" \
    && node --version \
    && java -version \
    && javac -version \
    && suitecloud --version

COPY --from=build /app/dist/ /opt/suitecontainer/
COPY gitlab-askpass.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/gitlab-askpass.sh \
    && printf '{"type":"module"}\n' > /opt/suitecontainer/package.json \
    && mkdir -p /workspace /config

WORKDIR /workspace
ENTRYPOINT ["node", "/opt/suitecontainer/install.js"]
